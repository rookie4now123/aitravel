LLM_PROVIDER=gemini compatible
LLM_API_KEY=
LLM_MODEL=gemini-2.5-flash-lite
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=1

# RAG / SQLite
RAG_SQLITE_DB_PATH=db/rag.sqlite3

# Redis / Cache
REDIS_ENABLED=false
REDIS_URL=redis://127.0.0.1:6379/0
REDIS_KEY_PREFIX=trip_planner
REDIS_DEFAULT_TTL_SECONDS=1800
REDIS_WEATHER_TTL_SECONDS=1800
REDIS_MAP_TTL_SECONDS=86400
REDIS_RAG_TTL_SECONDS=21600

# Google Maps
GOOGLE_MAPS_API_KEY=your_google_maps_api_key
GOOGLE_MAPS_BASE_URL=https://www.google.com/maps
GOOGLE_MAPS_DEFAULT_CITY= KRAKOW
GOOGLE_MAPS_TIMEOUT_SECONDS=20
ENABLE_GOOGLE_MAPS_ENRICHMENT=false
